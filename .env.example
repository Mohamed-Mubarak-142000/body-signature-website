# The Body Signature backend API (zefaaf-body-signature-backend), used by
# app/api/contact and app/api/auth/* to forward requests server-side.
BACKEND_URL="http://localhost:3001"

# Auth.js — customer session for this site.
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (customer sign-in) — the redirect lands here, not on the backend.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth (customer sign-in) — Meta for Developers → your app →
# Settings → Basic. Add "https://<this-site>/api/auth/callback/facebook" as
# a valid OAuth redirect URI in the Facebook Login product settings.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Must match the backend's INTERNAL_API_SECRET exactly — see
# app/api/auth/[...nextauth] via lib/auth.ts's signIn callback and the
# backend's app/api/auth/google/route.ts and app/api/auth/facebook/route.ts.
INTERNAL_API_SECRET=""
